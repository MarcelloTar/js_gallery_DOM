"use strict";
var largeImg = document.querySelector("#largeImg");
var thumbs = document.querySelector("#thumbs");
thumbs.addEventListener("click", function(e) {
    e.preventDefault();
    var url = window.location.origin;
    if (e.target.classList.contains("list-item__link")) largeImg.src = url + e.target.pathname;
    if (e.target.classList.contains("gallery__img")) {
        var src = e.target.src.split("/landscape")[1].split("-thumb")[0];
        largeImg.src = url + "/images/landscape" + src + ".png";
    }
});

